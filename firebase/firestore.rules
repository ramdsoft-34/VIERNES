rules_version = '2';

// Reglas de seguridad de Viernes.
// Cada usuario solo puede leer y escribir sus propios datos:
//   users/{uid}                  perfil y preferencias
//   users/{uid}/reminders/{id}   recordatorios
//   users/{uid}/events/{id}      historial
// Copia este archivo en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() < 40
          && (request.resource.data.deleted == true
              || (request.resource.data.title is string
                  && request.resource.data.title.size() <= 200));
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() < 20;
      }
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
