rules_version = '2';

// Fotos y notas de voz de los recordatorios. Cada usuario solo puede leer y
// escribir sus archivos: users/{uid}/attachments/{id}.jpg|m4a
// Copia este archivo en Firebase → Storage → Reglas → Publicar
// (o «firebase deploy --only storage»).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/attachments/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
